<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Royal Chicken Hub</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#fffdf5;
    color:#222;
}

header{
    background:#075b2a;
    color:white;
    padding:18px;
    text-align:center;
}

header h1{
    font-size:30px;
}

header p{
    margin-top:5px;
}

nav{
    background:white;
    padding:15px;
    text-align:center;
    position:sticky;
    top:0;
    box-shadow:0 2px 8px #ccc;
    z-index:10;
}

nav a{
    color:#075b2a;
    text-decoration:none;
    font-weight:bold;
    margin:0 12px;
}

.hero{
    max-width:1100px;
    margin:25px auto;
    padding:0 15px;
}

.hero img{
    width:100%;
    border-radius:20px;
    display:block;
}

.order{
    display:block;
    width:220px;
    margin:20px auto;
    padding:14px;
    background:#075b2a;
    color:white;
    text-align:center;
    border-radius:30px;
    text-decoration:none;
    font-weight:bold;
}

section{
    max-width:1100px;
    margin:auto;
    padding:55px 15px;
}

h2{
    text-align:center;
    color:#075b2a;
    margin-bottom:30px;
    font-size:32px;
}

.features{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
}

.feature{
    background:white;
    padding:25px;
    text-align:center;
    border-radius:15px;
    box-shadow:0 4px 15px #ddd;
}

